# Contributor: Peter Kosyh <p.kosyhgmail.com>

pkgname=instead
pkgver=3.6.0
pkgrel=1
pkgdesc="instead quest interpreter"
arch=('i686' 'x86_64')
url="https://github.com/instead-hub/instead/"
license=('MIT')
depends=('sdl3_image' 'sdl3_mixer' 'sdl3_ttf' 'lua')
source=(https://github.com/instead-hub/instead/releases/download/${pkgver}/instead_${pkgver}.tar.gz)
md5sums=('SKIP')

optdepends=('instead-launcher: install and update INSTEAD games from net')

build() {
cd "${srcdir}/instead-${pkgver}"

echo "2" | ./configure.sh
make PREFIX=/usr
}

package() {
cd "${srcdir}/instead-${pkgver}"

make DESTDIR="${pkgdir}" PREFIX=/usr install
}
